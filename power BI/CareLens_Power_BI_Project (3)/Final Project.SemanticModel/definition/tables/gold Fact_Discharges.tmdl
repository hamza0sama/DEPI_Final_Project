	measure 'Neonatal Mortality Share' = DIVIDE ( [Neonatal Expired Discharges], [Neonatal Discharges] )
		formatString: 0.0%
		displayFolder: 5 Neonatal
		lineageTag: c4312f2a-f858-5307-b6e2-dead11ed6172

	measure 'Open Date Missing Facilities' =
			CALCULATE (
			    DISTINCTCOUNT ( 'gold Fact_Discharges'[FacilityKey] ),
			    'gold Dim_Facility'[Is_Open_Date_Missing] = TRUE ()
			)
		formatString: #,0
		displayFolder: 6 Facility Quality
		lineageTag: ecacdcba-c852-5956-a8b1-82cc024c2c7c

	measure 'Location Missing Facilities' =
			CALCULATE (
