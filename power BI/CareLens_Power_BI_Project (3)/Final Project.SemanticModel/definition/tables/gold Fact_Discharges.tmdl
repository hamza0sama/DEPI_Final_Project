	measure 'Operator Average Cost per Discharge' = DIVIDE ( [Operator Costs], [Operator Discharges] )
		formatString: "$"#,0
		displayFolder: 7 Ownership
		lineageTag: 57f7bb0d-9968-5691-b8af-429ffa27718a

	measure 'Operator Average LOS' =
			CALCULATE (
			    [Average LOS],
			    CROSSFILTER ( 'gold Bridge_Facility_Operator'[FacilityKey], 'gold Dim_Facility'[FacilityKey], BOTH )
			)
		formatString: 0.0
		displayFolder: 7 Ownership
		lineageTag: 55d9c200-5dbb-540b-b96e-2abc61c4a380

	measure 'Data Period' =
			VAR FirstYear = CALCULATE ( MIN ( 'gold Dim_Year'[Year] ), ALL ( 'gold Dim_Year' ) )
			VAR LastYear = CALCULATE ( MAX ( 'gold Dim_Year'[Year] ), ALL ( 'gold Dim_Year' ) )
			RETURN
			    FirstYear & "-" & LastYear
		displayFolder: 8 Footer
		lineageTag: b0409b5d-a478-5762-821d-e823efe18c5d

	measure 'Footer Text' =
			"Data period: " & [Data Period]
			    & "  |  Data loaded: " & FORMAT ( MAX ( 'gold Fact_Discharges'[LoadDate] ), "d mmm yyyy" )
			    & "  |  De-identified inpatient discharge data (NY SPARCS)  |  Charges are not collected revenue; patterns are descriptive, not causal."
		displayFolder: 8 Footer
		lineageTag: 0e1c6288-6d0b-564a-88d8-de336822626d

	measure 'Emergency Average LOS' =
			CALCULATE (
			    [Average LOS],
			    'gold Dim_Admission'[EmergencyDepartmentIndicator] = 1
			)
		formatString: 0.0
		displayFolder: 9 Comparison and Ranking
		lineageTag: f6ac716a-a633-54bc-837d-e93179df0f06

	measure 'Non-Emergency Average LOS' =
			CALCULATE (
			    [Average LOS],
			    'gold Dim_Admission'[EmergencyDepartmentIndicator] = 0
			)
		formatString: 0.0
		displayFolder: 9 Comparison and Ranking
		lineageTag: 625bbb64-49bc-513c-b28e-e823bcd50c6e

	measure 'Ranked Average LOS' = IF ( [Total Discharges] >= 100, [Average LOS] )
		formatString: 0.0
		displayFolder: 9 Comparison and Ranking
		lineageTag: f22f5981-0017-52ff-9956-4d11b560d5d7

	measure 'Ranked Average Cost per Discharge' = IF ( [Total Discharges] >= 100, [Average Cost per Discharge] )
		formatString: "$"#,0
		displayFolder: 9 Comparison and Ranking
		lineageTag: 00f6c92b-945c-5b9b-9195-4dcfbbf01850

	measure 'Ranked Extreme Severity Share' = IF ( [Total Discharges] >= 100, [Extreme Severity Share] )
		formatString: 0.0%
		displayFolder: 9 Comparison and Ranking
		lineageTag: 0ea275ec-4e91-5875-8641-7d31becc72f3

	measure 'Unmapped Facility Discharges' =
			CALCULATE (
			    [Total Discharges],
			    'gold Dim_Facility'[Facility_Name] = BLANK ()
			)
		formatString: #,0
		displayFolder: 6 Facility Quality
		lineageTag: 3f5f1c58-cb6b-5d3f-8502-5a17ee7833a0

	measure 'Ranked Discharges Abs Change' =
			VAR Cur = [Discharges Current Year]
			VAR Prev = [Discharges Previous Year]
			RETURN
			    IF ( Cur >= 100 && Prev >= 100, ABS ( Cur - Prev ) )
		formatString: #,0
		displayFolder: 9 Comparison and Ranking
		lineageTag: 5ac4af6f-56b2-5127-bbd8-32918ac34ccc

