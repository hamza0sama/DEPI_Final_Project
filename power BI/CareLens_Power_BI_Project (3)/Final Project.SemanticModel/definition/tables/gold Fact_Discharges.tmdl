		formatString: "$"#,0
		displayFolder: 3 Time
		lineageTag: 8b73b1f1-ae88-5ad0-8b41-3232698ace54

	measure 'Costs YoY %' = DIVIDE ( [Costs Current Year] - [Costs Previous Year], [Costs Previous Year] )
		formatString: 0.0%
		displayFolder: 3 Time
		lineageTag: 7e20bc8b-7350-53e4-abe8-72b154c4c01b

	measure 'Average LOS Previous Year' =
			VAR SelectedYear = MAX ( 'gold Dim_Year'[Year] )
			RETURN
			    CALCULATE (
			        [Average LOS],
			        FILTER (
			            ALL ( 'gold Dim_Year'[Year] ),
			            'gold Dim_Year'[Year] = SelectedYear - 1
			        )
			    )
		formatString: 0.0
		displayFolder: 3 Time
		lineageTag: 75d8c63b-d7dc-59df-89c1-959aaeeb5c6c

	measure 'Average LOS Current Year' =
			VAR SelectedYear = MAX ( 'gold Dim_Year'[Year] )
			RETURN
			    CALCULATE (
			        [Average LOS],
			        REMOVEFILTERS ( 'gold Dim_Year' ),
			        'gold Dim_Year'[Year] = SelectedYear
			    )
		formatString: 0.0
		displayFolder: 3 Time
		lineageTag: b4f8267a-7867-57fc-ad83-f839262fb476

	measure 'Average LOS Change' =
			IF (
			    ISBLANK ( [Average LOS Previous Year] ),
			    BLANK (),
			    [Average LOS Current Year] - [Average LOS Previous Year]
			)
		formatString: +0.00;-0.00;0.00
		displayFolder: 3 Time
		lineageTag: 7f9356a0-0a00-542f-a583-1239ebc951a8

	measure 'Scenario Discharges - Flat' = [Discharges Current Year]
		formatString: #,0
		displayFolder: 4 Scenario
		lineageTag: c81ac8c9-5ad6-5eae-a03a-f1e17aa37f26

	measure 'Scenario Discharges - Trend Continues' =
			IF (
			    ISBLANK ( [Discharges YoY %] ),
			    BLANK (),
			    [Discharges Current Year] * ( 1 + [Discharges YoY %] )
			)
		formatString: #,0
		displayFolder: 4 Scenario
		lineageTag: d302f7cd-46f3-5131-8768-c025dc2dd7b1

	measure 'Scenario Costs - Trend Continues' =
			IF (
			    ISBLANK ( [Costs YoY %] ),
			    BLANK (),
			    [Costs Current Year] * ( 1 + [Costs YoY %] )
			)
		formatString: "$"#,0
		displayFolder: 4 Scenario
		lineageTag: b54c5672-3942-520f-aada-fd3674d50e52

	measure 'Neonatal Average LOS' =
			CALCULATE (
			    [Average LOS],
			    'gold Fact_Discharges'[IsNeonate] = TRUE ()
			)
		formatString: 0.0
		displayFolder: 5 Neonatal
		lineageTag: 026c8541-1387-58f7-b2de-3fa62075e28f

	measure 'Neonatal Average Cost per Discharge' =
