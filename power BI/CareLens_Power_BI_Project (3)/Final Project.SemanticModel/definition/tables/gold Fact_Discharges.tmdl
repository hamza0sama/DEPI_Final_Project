			)
		formatString: #,0
		displayFolder: 6 Facility Quality
		lineageTag: fe3428e5-cc6d-58bb-ba03-cb18971de9c0

	measure 'Operator Count' =
			CALCULATE (
			    DISTINCTCOUNT ( 'gold Bridge_Facility_Operator'[OperatorKey] ),
			    TREATAS ( VALUES ( 'gold Fact_Discharges'[FacilityKey] ), 'gold Bridge_Facility_Operator'[FacilityKey] )
			)
		formatString: #,0
		displayFolder: 7 Ownership
		lineageTag: 3f84b054-6fe1-5932-9864-db20349fddd6

	measure 'Cooperator Count' =
			CALCULATE (
			    DISTINCTCOUNT ( 'gold Bridge_Facility_Cooperator'[CooperatorKey] ),
			    TREATAS ( VALUES ( 'gold Fact_Discharges'[FacilityKey] ), 'gold Bridge_Facility_Cooperator'[FacilityKey] )
			)
		formatString: #,0
		displayFolder: 7 Ownership
		lineageTag: 46a5b15e-4a95-5176-a69f-04f48c09e865

	measure 'Operator Facility Count' =
			CALCULATE (
			    DISTINCTCOUNT ( 'gold Bridge_Facility_Operator'[FacilityKey] ),
			    TREATAS ( VALUES ( 'gold Fact_Discharges'[FacilityKey] ), 'gold Bridge_Facility_Operator'[FacilityKey] )
			)
		formatString: #,0
