		lineageTag: 1119ea59-8653-50a3-844b-b9c11ffc836d

	measure 'Operator Discharges' =
			CALCULATE (
			    [Total Discharges],
			    CROSSFILTER ( 'gold Bridge_Facility_Operator'[FacilityKey], 'gold Dim_Facility'[FacilityKey], BOTH )
			)
		formatString: #,0
		displayFolder: 7 Ownership
		lineageTag: 9fba574d-c1a6-5461-9fd2-cf6668f2c3b5

	measure 'Operator Costs' =
			CALCULATE (
