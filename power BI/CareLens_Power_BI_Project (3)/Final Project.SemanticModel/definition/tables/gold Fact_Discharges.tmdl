table 'gold Fact_Discharges'
	lineageTag: b31e58f5-7f92-4ed2-9b5d-1b271e970b82

	measure 'Total Discharges' = COUNTROWS ( 'gold Fact_Discharges' )
		formatString: #,0
		displayFolder: 1 Core
		lineageTag: 2c046603-e186-510a-8e82-3b5697ce8bc3

	measure 'Total Charges' = SUM ( 'gold Fact_Discharges'[TotalCharges] )
		formatString: "$"#,0
		displayFolder: 1 Core
		lineageTag: c7df839f-0db8-56b6-a611-9864e5413769

	measure 'Total Costs' = SUM ( 'gold Fact_Discharges'[TotalCosts] )
		formatString: "$"#,0
		displayFolder: 1 Core
		lineageTag: 92405097-0798-5862-a28f-2a8b0de3a98a

	measure 'Average LOS' = AVERAGE ( 'gold Fact_Discharges'[LengthOfStay] )
		formatString: 0.0
		displayFolder: 1 Core
		lineageTag: b7959d2f-ba92-5f02-8009-7d8db2c57703

	measure 'Average Cost per Discharge' = DIVIDE ( [Total Costs], [Total Discharges] )
		formatString: "$"#,0
		displayFolder: 1 Core
		lineageTag: 6ccb2d6a-6b9d-5954-a80e-c2cb724d7a22

	measure 'Average Charge per Discharge' = DIVIDE ( [Total Charges], [Total Discharges] )
		formatString: "$"#,0
		displayFolder: 1 Core
		lineageTag: 4f91366f-a9b9-5cd6-8450-43cdad7cb544

	measure 'Cost-to-Charge Ratio' = DIVIDE ( [Total Costs], [Total Charges] )
		formatString: 0.0%
		displayFolder: 1 Core
		lineageTag: e6d26b2e-9811-5a4f-84d1-908e1285636a

	measure 'Charge-Cost Difference' = [Total Charges] - [Total Costs]
		formatString: "$"#,0
		displayFolder: 1 Core
		lineageTag: fc9a3901-dfb0-5403-b257-820978a02217

	measure 'Average Total Cost' = AVERAGE ( 'gold Fact_Discharges'[TotalCosts] )
		formatString: "$"#,0
		displayFolder: 1 Core
		lineageTag: f35e595f-838a-5fae-8925-a2d1952002e0

	measure 'Average Total Charge' = AVERAGE ( 'gold Fact_Discharges'[TotalCharges] )
		formatString: "$"#,0
		displayFolder: 1 Core
		lineageTag: 4691d617-cf0d-527f-b470-4c61e11e9264

	measure 'Average Cost-to-Charge Ratio' = AVERAGE ( 'gold Fact_Discharges'[CostToChargeRatio] )
		formatString: 0.0%
		displayFolder: 1 Core
		lineageTag: 1a72aa8b-daef-5a35-b6eb-7600e2318323

	measure 'Facility Count' = DISTINCTCOUNT ( 'gold Fact_Discharges'[FacilityKey] )
		formatString: #,0
		displayFolder: 1 Core
		lineageTag: b0e61e0d-cd10-511c-9e8e-f75ad3a28a3b

	measure 'Emergency Discharges' =
			CALCULATE (
			    [Total Discharges],
			    'gold Dim_Admission'[EmergencyDepartmentIndicator] = 1
			)
		formatString: #,0
		displayFolder: 2 Shares
		lineageTag: fac1d173-baed-531f-a011-92a21a9e5b3f

	measure 'Emergency Share' = DIVIDE ( [Emergency Discharges], [Total Discharges] )
		formatString: 0.0%
		displayFolder: 2 Shares
		lineageTag: 651db80f-3800-598e-8ee4-e77180a782d4

	measure 'Procedure Discharges' =
			CALCULATE (
			    [Total Discharges],
			    'gold Fact_Discharges'[HasProcedure] = TRUE ()
			)
		formatString: #,0
		displayFolder: 2 Shares
		lineageTag: 82302e88-90d5-5f46-a23a-fc4f7d169255

	measure 'Procedure Share' = DIVIDE ( [Procedure Discharges], [Total Discharges] )
		formatString: 0.0%
		displayFolder: 2 Shares
		lineageTag: 7378bfee-a9b6-5fcd-bdc5-214322a40b04

	measure 'Neonatal Discharges' =
			CALCULATE (
			    [Total Discharges],
			    'gold Fact_Discharges'[IsNeonate] = TRUE ()
			)
		formatString: #,0
		displayFolder: 2 Shares
		lineageTag: 5d6feb15-baec-5489-a590-7b00f6b04dd2

	measure 'Neonatal Share' = DIVIDE ( [Neonatal Discharges], [Total Discharges] )
		formatString: 0.0%
		displayFolder: 2 Shares
		lineageTag: 95f30573-51ac-55cb-b607-b5fd00e7101d

	measure 'Secondary Insurance Discharges' =
			CALCULATE (
			    [Total Discharges],
			    'gold Fact_Discharges'[HasSecondaryInsurance] = TRUE ()
			)
		formatString: #,0
		displayFolder: 2 Shares
		lineageTag: d3824a33-959e-53f0-bb67-45f7527a9f66

	measure 'Secondary Insurance Share' = DIVIDE ( [Secondary Insurance Discharges], [Total Discharges] )
		formatString: 0.0%
		displayFolder: 2 Shares
		lineageTag: 82af8f99-972e-5310-89d5-eae4773b3b7c

	measure 'Expired Discharges' =
			CALCULATE (
			    [Total Discharges],
			    'gold Dim_Admission'[PatientDisposition] = "Expired"
			)
		formatString: #,0
		displayFolder: 2 Shares
		lineageTag: 2db2fb53-8bc7-56e7-836f-1a10a3853da6

	measure 'Mortality Share' = DIVIDE ( [Expired Discharges], [Total Discharges] )
		formatString: 0.0%
		displayFolder: 2 Shares
		lineageTag: 6f29f77f-6a24-533b-8321-127d76be01c8

	measure 'Extreme Severity Discharges' =
			CALCULATE (
			    [Total Discharges],
			    'gold Dim_Severity'[AprSeverityOfIllnessCode] = 4
			)
		formatString: #,0
		displayFolder: 2 Shares
		lineageTag: fdde391a-559e-58d1-a096-613b0fa9f2c7

	measure 'Extreme Severity Share' = DIVIDE ( [Extreme Severity Discharges], [Total Discharges] )
		formatString: 0.0%
		displayFolder: 2 Shares
		lineageTag: 37516886-407d-51a5-b7c2-11f3f47ca03b

	measure 'Top 5 Facilities Share' =
			DIVIDE (
			    SUMX (
			        TOPN ( 5, ALLSELECTED ( 'gold Dim_Facility'[Facility_Name] ), [Total Discharges] ),
			        [Total Discharges]
			    ),
			    CALCULATE ( [Total Discharges], ALLSELECTED ( 'gold Dim_Facility' ) )
			)
		formatString: 0.0%
		displayFolder: 2 Shares
		lineageTag: 2ddbbc5e-eee6-5017-81a0-07bf839b903a

	measure 'Discharges Previous Year' =
			VAR SelectedYear = MAX ( 'gold Dim_Year'[Year] )
			RETURN
			    CALCULATE (
			        [Total Discharges],
			        FILTER (
			            ALL ( 'gold Dim_Year'[Year] ),
			            'gold Dim_Year'[Year] = SelectedYear - 1
			        )
			    )
		formatString: #,0
		displayFolder: 3 Time
		lineageTag: 47db90fa-e6ed-5c06-a349-bb4a3fd55b47

	measure 'Discharges Current Year' =
			VAR SelectedYear = MAX ( 'gold Dim_Year'[Year] )
			RETURN
			    CALCULATE (
			        [Total Discharges],
			        REMOVEFILTERS ( 'gold Dim_Year' ),
			        'gold Dim_Year'[Year] = SelectedYear
			    )
		formatString: #,0
		displayFolder: 3 Time
		lineageTag: 9181757d-a66a-54b9-849a-67fb667e95d2

	measure 'Discharges YoY %' = DIVIDE ( [Discharges Current Year] - [Discharges Previous Year], [Discharges Previous Year] )
		formatString: 0.0%
		displayFolder: 3 Time
		lineageTag: 1c46e642-91ce-5b30-b7cd-801415f35e93

	measure 'Discharges Change' =
			IF (
			    ISBLANK ( [Discharges Previous Year] ),
			    BLANK (),
			    [Discharges Current Year] - [Discharges Previous Year]
			)
		formatString: #,0
		displayFolder: 3 Time
		lineageTag: 664d756a-5870-52a8-b2f1-08c9bec0e865

	measure 'Discharges Abs Change' = ABS ( [Discharges Change] )
		formatString: #,0
		displayFolder: 3 Time
		lineageTag: 36d1682d-b5b5-512c-a38b-971a6c302f63

	measure 'Charges Previous Year' =
			VAR SelectedYear = MAX ( 'gold Dim_Year'[Year] )
			RETURN
			    CALCULATE (
			        [Total Charges],
			        FILTER (
			            ALL ( 'gold Dim_Year'[Year] ),
			            'gold Dim_Year'[Year] = SelectedYear - 1
			        )
			    )
		formatString: "$"#,0
		displayFolder: 3 Time
		lineageTag: c1df6c65-3755-5efc-9ad6-38508ed68f1a

	measure 'Charges Current Year' =
			VAR SelectedYear = MAX ( 'gold Dim_Year'[Year] )
			RETURN
			    CALCULATE (
			        [Total Charges],
			        REMOVEFILTERS ( 'gold Dim_Year' ),
			        'gold Dim_Year'[Year] = SelectedYear
			    )
		formatString: "$"#,0
		displayFolder: 3 Time
		lineageTag: 9e3e356a-f8dc-5256-9052-8254e479ab97

	measure 'Charges YoY %' = DIVIDE ( [Charges Current Year] - [Charges Previous Year], [Charges Previous Year] )
		formatString: 0.0%
		displayFolder: 3 Time
		lineageTag: a5904d53-c597-53c6-9691-69fa7853c60b

	measure 'Costs Previous Year' =
			VAR SelectedYear = MAX ( 'gold Dim_Year'[Year] )
			RETURN
			    CALCULATE (
			        [Total Costs],
			        FILTER (
			            ALL ( 'gold Dim_Year'[Year] ),
			            'gold Dim_Year'[Year] = SelectedYear - 1
			        )
			    )
		formatString: "$"#,0
		displayFolder: 3 Time
		lineageTag: ecfa704e-fb50-5ce2-ae24-40ae199aad7a

	measure 'Costs Current Year' =
			VAR SelectedYear = MAX ( 'gold Dim_Year'[Year] )
			RETURN
